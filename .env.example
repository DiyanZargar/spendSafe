# Application Settings
APP_NAME=Agentic Expense Tracker
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=expense_tracker
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/expense_tracker
DB_ECHO=false

# Redis & Background Workers
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Security & Cryptography
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-in-production-use-a-strong-secret-key-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Encryption key for channel credentials (Fernet 32-byte url-safe base64)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=your-fernet-key-here-base64-encoded=

# CORS Settings (comma-separated list of origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# AI / Agno LLM Settings (optional - platform functions offline with built-in intent parser if empty)
OPENAI_API_KEY=
DEFAULT_LLM_MODEL=gpt-4o

# Note: Messaging channels (WhatsApp, Telegram, Slack) are configured strictly via the UI
# and their credentials are encrypted at rest with AES-Fernet using CREDENTIALS_ENCRYPTION_KEY.
# No channel tokens or credentials belong in .env or backend configurations.

# Frontend Configuration
VITE_API_URL=http://localhost:8000
